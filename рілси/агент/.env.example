# Скопіюйте цей файл у .env і впишіть свої ключі.
# Усі ключі необов'язкові — без них агент просто пропускає відповідний крок
# (без стоку — використовує лише бібліотеку; без TTS — рілс без озвучки).

# Стокове відео/фото як резерв, коли в бібліотеці немає відповідного матеріалу
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Озвучка тексту сценарію
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Аватар (майбутня інтеграція)
HEYGEN_API_KEY=
